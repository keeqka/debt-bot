{
  // Мини-апп Hlow Flow на Cloudflare Workers (статические ассеты из dist).
  // single-page-application: прямые заходы на /report/<id> отдают index.html, дальше роутит React.
  "name": "hlowflow-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
